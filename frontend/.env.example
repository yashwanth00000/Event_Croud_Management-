# PostgreSQL connection. Replace placeholders with your local credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eventcrowd?schema=public"

# MongoDB stores telemetry/document mirrors and supports crowd analytics.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DATABASE="eventcrowd"

# Optional semantic incident search; PostgreSQL full-text search works without Qdrant.
QDRANT_URL="http://127.0.0.1:6333"
# Set only when Qdrant requires authentication.
QDRANT_API_KEY=""

# Generate a unique random value of at least 32 characters for each environment.
SESSION_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

NEXT_PUBLIC_APP_NAME="EventCrowd"
